# SSA Disability Claims OpenLens — Environment Configuration
# Copy to .env and fill in values

# ── Server identity ────────────────────────────────────────────────────────────
OPENLENS_SERVER_NAME="SSA Disability Claims OpenLens"
OPENLENS_SERVER_VERSION="1.0.0"
OPENLENS_LOG_LEVEL="INFO"   # DEBUG | INFO | WARNING | ERROR

# ── Data source adapters ───────────────────────────────────────────────────────
# SSA Open Data Portal (https://www.ssa.gov/data/)
SSA_OPEN_DATA_BASE_URL="https://www.ssa.gov/data/"

# Data.gov catalog API v1 (https://catalog.data.gov/openapi.json). The old CKAN /api/3/action API was retired.
DATA_GOV_API_BASE_URL="https://catalog.data.gov/api/v1"
# Optional: Data.gov API key (improves rate limits)
DATA_GOV_API_KEY=""

# ── Cache settings ─────────────────────────────────────────────────────────────
# How long to cache dataset catalog results (seconds). 0 = disabled.
CATALOG_CACHE_TTL_SECONDS=3600

# ── Answer Coverage tuning ─────────────────────────────────────────────────────
# Minimum score threshold (0–100) to classify coverage as "High"
COVERAGE_HIGH_THRESHOLD=75
# Minimum score threshold (0–100) to classify coverage as "Partial"
COVERAGE_PARTIAL_THRESHOLD=40
# Minimum score threshold (0–100) to classify coverage as "Limited"
COVERAGE_LIMITED_THRESHOLD=15
